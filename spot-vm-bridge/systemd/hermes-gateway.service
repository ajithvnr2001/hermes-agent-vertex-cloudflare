[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration (Persistent on /data/hermes)
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/hermes/.hermes
Environment="HOME=/root"
Environment="USER=root"
Environment="LOGNAME=root"
Environment="HERMES_HOME=/data/hermes/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Environment="PATH=/root/.hermes/tools/node-26.7.0-linux-x64/bin:/root/.hermes/tools/npm-12.0.2-linux-x64/bin:/data/hermes/.hermes/hermes-agent/venv/bin:/data/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/data/hermes/.hermes/hermes-agent/venv/bin/hermes gateway run
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
