[Unit]
Description=Hermes Agent Web Dashboard (Persistent on /data/hermes)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/hermes/.hermes/hermes-agent
Environment="HOME=/root"
Environment="HERMES_HOME=/data/hermes/.hermes"
Environment="PATH=/data/hermes/.hermes/hermes-agent/venv/bin:/data/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/data/hermes/.hermes/hermes-agent/venv/bin/hermes dashboard --skip-build --no-open --port 9119
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
