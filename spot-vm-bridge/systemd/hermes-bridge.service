[Unit]
Description=Hermes Agent Web Dashboard Tunnel -> hermes.rpcserve.website (/data/hermes)
After=network-online.target local-fs.target hermes-dashboard.service
Wants=network-online.target hermes-dashboard.service

[Service]
Type=simple
User=root
WorkingDirectory=/data/hermes
Environment="HOME=/root"
Environment="HERMES_HOME=/data/hermes/.hermes"
Environment="PATH=/data/hermes/.hermes/hermes-agent/venv/bin:/data/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env bash /data/hermes/start-tunnel.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
