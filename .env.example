# ==============================================================================
# Hermes Agent — Spot VM Bridge, Sync Daemon & E2E Configuration (.env.example)
# Copy this file to /data/hermes/.env and fill in your values.
# ==============================================================================

# 1. Cloudflare Worker Public URL
HERMES_WORKER_URL="https://hermes.example.com"

# 2. Web UI Owner Authentication Credentials
HERMES_AUTH_USER="admin@example.com"
HERMES_AUTH_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# 3. Spot VM Bridge Shared Secret (must match BRIDGE_SECRET in Cloudflare Worker)
HERMES_BRIDGE_SECRET="CHANGE_ME_BRIDGE_SECRET"

# 4. Google Cloud Vertex AI Project Configuration (for E2E AI agent steps)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="global"

# 5. Persistent Disk Path on Spot VM / General VM
HERMES_DATA_DIR="/data/hermes"
